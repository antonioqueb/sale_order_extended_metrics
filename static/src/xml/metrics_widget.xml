<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sale_order_extended_metrics.SaleMetricsWidget">
        <div class="sm-root">
            <!-- ========== PAYMENTS TABLE ========== -->
            <t t-if="state.summary.has_payments">
                <div class="sm-section">
                    <div class="sm-section-header" t-on-click="togglePayments">
                        <i t-attf-class="fa #{state.showPayments ? 'fa-caret-down' : 'fa-caret-right'} sm-section-caret"/>
                        <span class="sm-section-title">Desglose de Pagos</span>
                        <span class="sm-section-count"><t t-esc="state.payments.length"/> pago(s)</span>
                    </div>
                    <t t-if="state.showPayments">
                        <div class="sm-table-container">
                            <table class="sm-table">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Referencia</th>
                                        <th>Diario</th>
                                        <th class="sm-th-num">Monto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.payments" t-as="pay" t-key="pay.id">
                                        <tr class="sm-row sm-row-clickable" t-on-click="() => this.openPayment(pay.id)">
                                            <td class="sm-td-date">
                                                <i class="fa fa-calendar-o sm-date-icon"/>
                                                <t t-esc="pay.date"/>
                                            </td>
                                            <td class="sm-td-link">
                                                <t t-esc="pay.name"/>
                                            </td>
                                            <td><t t-esc="pay.journal"/></td>
                                            <td class="sm-td-num sm-td-bold sm-num-paid">
                                                <t t-esc="pay.currency"/><t t-esc="formatNumber(pay.amount)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="sm-totals-row">
                                        <td class="sm-td-totals-label" colspan="3">Total Pagado</td>
                                        <td class="sm-td-num sm-td-bold sm-num-paid">
                                            <t t-esc="state.summary.currency"/><t t-esc="formatNumber(state.summary.total_paid)"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </t>
                </div>
            </t>

        </div>
    </t>

</templates>
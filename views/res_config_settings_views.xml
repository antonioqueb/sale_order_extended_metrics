<odoo>
    <record id="res_config_settings_view_form_flow_light" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.flow.light</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='catalog_setting_container']" position="after">
                <h2>Semáforo de flujo de dinero</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="flow_no_payment_days"/>
                            <field name="flow_no_payment_days" class="oe_inline"/>
                            <div class="text-muted">Sin ningún pago: hasta estos días la orden es "Nueva" (duración del apartado).</div>
                            <label for="flow_dead_days" class="mt-2"/>
                            <field name="flow_dead_days" class="oe_inline"/>
                            <div class="text-muted">Sin ningún pago: a partir de estos días es "Dejado" (negro).</div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="flow_stale_days"/>
                            <field name="flow_stale_days" class="oe_inline"/>
                            <div class="text-muted">Con anticipo y saldo pendiente: días desde el último pago para pasar de "Al día" a "Lenta".</div>
                            <label for="flow_stalled_days" class="mt-2"/>
                            <field name="flow_stalled_days" class="oe_inline"/>
                            <div class="text-muted">Días desde el último pago para "Estancada".</div>
                            <div class="text-muted mt-2"><strong>Agravante por entrega:</strong> sin ningún pago y con material entregado, el semáforo sube un nivel de inmediato; con pago parcial, si lo entregado supera lo pagado por más de 20 puntos, también sube un nivel.</div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

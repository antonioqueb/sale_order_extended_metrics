<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_extended_metrics" model="ir.ui.view">
        <field name="name">sale.order.form.extended.metrics</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">

            <!-- Métricas en líneas -->
            <xpath expr="//field[@name='order_line']/list//field[@name='qty_delivered']" position="after">
                <field name="fulfillment_percent" widget="percentage" optional="show" 
                    column_invisible="parent.state != 'sale'"
                    decoration-success="fulfillment_percent == 1" 
                    decoration-warning="fulfillment_percent &lt; 1 and fulfillment_percent &gt; 0"/>
                <field name="returned_qty_m2" optional="show" 
                    column_invisible="parent.state != 'sale'"
                    decoration-danger="returned_qty_m2 &gt; 0"/>
                <field name="returned_amount" optional="hide" column_invisible="parent.state != 'sale'"/>
            </xpath>

            <!-- Pendiente por Pagar (Debajo del total) -->
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="amount_pending_to_pay" 
                       class="oe_subtotal_footer_separator" 
                       decoration-bf="1" 
                       decoration-danger="amount_pending_to_pay &gt; 0"/>
            </xpath>

            <!-- Widget de métricas -->
            <xpath expr="//notebook" position="after">
                <div class="o_group" style="width: 100%;">
                    <field name="metrics_data" widget="sale_metrics_widget" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>